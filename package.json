{
	"name": "effect-lab",
	"version": "0.1.0",
	"description": "A private browser photo lab. BOY II is the first reconstructed effect.",
	"homepage": "https://ochen1.github.io/effect-lab/",
	"repository": {
		"type": "git",
		"url": "https://github.com/ochen1/effect-lab.git"
	},
	"packageManager": "bun@1.4.2",
	"private": true,
	"type": "module",
	"scripts": {
		"vendor": "bun tools/copy-runtime.ts",
		"predev": "bun run vendor",
		"dev": "vite --host 127.0.0.1",
		"prebuild": "bun run vendor",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"test": "bun test src tests",
		"check:site": "bun tools/check-site.ts"
	},
	"dependencies": {
		"onnxruntime-web": "1.30.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.10",
		"typescript": "5.9.3",
		"vite": "8.3.4"
	}
}
